DATA_MODE=synthetic
NETWORK_MODE=off
# Never add Chromie, customer, or enrichment credentials.

# SAM.gov site API. The keyless site API is what the tools use; this is only for the
# legacy api.sam.gov endpoints.
# SAM_API_KEY=

# News discovery by query (research/tools/news.py search). Only this one command needs it:
# the feeds and index pages in `news.py watch` are public and need no key, and `news.py build`
# reads bytes that are already saved.
# EXA_API_KEY=

# The same discovery through RouterGrowth, which routes one query to whichever provider is live
# behind a capability (`news.py sweep --provider routergrowth`). `/v1/discover` answers without a
# key; `/v1/inspect` and `/v1/run` need one, and runs are drawn from a prepaid wallet.
# ROUTERGROWTH_API_KEY=
# ROUTERGROWTH_CAPABILITY=news.search

# US egress for the .mil hosts that answer only a United States address (research/tools/browserbase_fetch.py).
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
